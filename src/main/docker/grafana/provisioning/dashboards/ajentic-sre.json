{
  "title": "Ajentic SRE",
  "uid": "ajentic-sre",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Episodes started / finished",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(ajentic_episodes_started_total[5m]))", "legendFormat": "started" },
        { "expr": "sum by (solved) (rate(ajentic_episodes_finished_total[5m]))", "legendFormat": "finished solved={{solved}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Mean episode reward",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(ajentic_episode_reward_sum[5m])) / clamp_min(sum(rate(ajentic_episode_reward_count[5m])), 1)",
          "legendFormat": "reward"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(ajentic_tool_latency_seconds_bucket[5m])))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM tokens",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (kind) (rate(ajentic_llm_tokens_total[5m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    }
  ]
}
