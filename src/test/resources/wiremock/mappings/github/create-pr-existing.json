{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPathPattern": "/repos/acme/checkout-service/pulls",
    "bodyPatterns": [
      {
        "contains": "ajentic/existing-pr"
      }
    ]
  },
  "response": {
    "status": 422,
    "jsonBody": {
      "message": "A pull request already exists for acme:ajentic/existing-pr."
    }
  }
}
