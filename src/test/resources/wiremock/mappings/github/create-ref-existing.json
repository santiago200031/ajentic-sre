{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPathPattern": "/repos/acme/checkout-service/git/refs",
    "bodyPatterns": [
      {
        "contains": "ajentic/existing-branch"
      }
    ]
  },
  "response": {
    "status": 422,
    "jsonBody": {
      "message": "Reference already exists"
    }
  }
}
